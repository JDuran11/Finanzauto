{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "CONFIGURE_IN_USER_SECRETS_OR_ENVIRONMENT_VARIABLES"
  },
  "Jwt": {
    "Key": "CONFIGURE_IN_USER_SECRETS_OR_ENVIRONMENT_VARIABLES",
    "Issuer": "FinanzautoAPI",
    "Audience": "FinanzautoClients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "Cloudinary": {
    "CloudName": "CONFIGURE_IN_USER_SECRETS_OR_ENVIRONMENT_VARIABLES",
    "ApiKey": "CONFIGURE_IN_USER_SECRETS_OR_ENVIRONMENT_VARIABLES",
    "ApiSecret": "CONFIGURE_IN_USER_SECRETS_OR_ENVIRONMENT_VARIABLES"
  },
  "Security": {
    "AllowedOrigins": [
      "https://localhost:5001",
      "https://finanzauto.com"
    ],
    "RequireHttps": true,
    "EnableHsts": true,
    "MaxRequestBodySize": 10485760
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowMinutes": 1
    },
    "Api": {
      "PermitLimit": 100,
      "WindowMinutes": 1
    }
  }
}
